<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:ai="urn:import:com.google.appinventor.client.widgets"
             xmlns:actions="urn:import:com.google.appinventor.client.actions"
             xmlns:neo="urn:import:com.google.appinventor.client.style.neo"
             ui:generatedFormat="com.google.gwt.i18n.server.PropertyCatalogFactory"
             ui:generatedKeys="com.google.gwt.i18n.server.keygen.MethodNameKeyGenerator"
             ui:generateLocales="default">
  <ui:with field="messages" type="com.google.appinventor.client.OdeMessages"/>
  <ui:with field="config" type="com.google.appinventor.client.OdeMessages"/>
  <ui:with field="myProjects" type="com.google.appinventor.client.widgets.TextButton"/>
  <ui:with field="viewTrash" type="com.google.appinventor.client.widgets.TextButton"/>
  <g:FlowPanel styleName="ode-TopPanel flex items-center justify-between px-4 py-2  border-b border-slate-200/80 shadow-2xs w-full text-slate-800 font-sans h-14">
    <g:HTML styleName="flex items-center">
      <img srcset="" class="ode-Logo h-7 w-auto cursor-pointer transition hover:opacity-90" ui:field="logo" />
    </g:HTML>
    <neo:TopToolbarNeo ui:field="topToolbar"/>
    <g:FlowPanel ui:field="rightPanel" styleName="flex items-center gap-3">
      <g:FlowPanel styleName="ode-TopPanelAccount flex items-center gap-2">
        <g:Label text="{messages.readOnlyMode}" styleName="ode-TopPanelWarningLabel text-xs text-red-600 font-semibold px-2.5 py-1 bg-red-50 rounded-full border border-red-200/80"
                 ui:field="readOnly"/>
        <!-- Help Menu -->
        <ai:DropDownButton name="Help" caption="{messages.helpTabName}" styleName="ode-TopPanelButton px-3 py-1.5 rounded-lg text-sm font-medium text-[#4f46e5] hover:text-indigo-800 hover:bg-indigo-50/80 active:bg-indigo-100/70 transition duration-150 cursor-pointer border-0 bg-transparent outline-none flex items-center gap-1"
                           ui:field="helpDropDown" align="right" icon="help">
          <ai:DropDownItem name="About" caption="{messages.aboutMenuItem}">
            <actions:AboutAction/>
          </ai:DropDownItem>
          <hr/>
          <ai:DropDownItem name="Guide" caption="{messages.guideTabName}">
            <actions:OpenGuideAction/>
          </ai:DropDownItem>
          <ai:DropDownItem name="Feedback" caption="{messages.feedbackTabName}">
            <actions:OpenFeedbackAction/>
          </ai:DropDownItem>
          <ai:DropDownItem name="Library" caption="{messages.libraryMenuItem}">
            <actions:OpenLinkAction link_name="Library"/>
          </ai:DropDownItem>
          <ai:DropDownItem name="GetStarted" caption="{messages.getStartedMenuItem}">
            <actions:OpenLinkAction link_name="GetStarted"/>
          </ai:DropDownItem>
          <ai:DropDownItem name="Extensions" caption="{messages.extensionsMenuItem}">
            <actions:OpenLinkAction link_name="Extensions"/>
          </ai:DropDownItem>
          <ai:DropDownItem name="Tutorials" caption="{messages.tutorialsMenuItem}">
            <actions:OpenLinkAction link_name="Tutorials"/>
          </ai:DropDownItem>
          <ai:DropDownItem name="Troubleshooting" caption="{messages.troubleshootingMenuItem}">
            <actions:OpenLinkAction link_name="Troubleshooting"/>
          </ai:DropDownItem>
          <ai:DropDownItem name="Forums" caption="{messages.forumsMenuItem}">
            <actions:OpenLinkAction link_name="Forums"/>
          </ai:DropDownItem>
          <ai:DropDownItem name="ShowSplash" caption="{messages.showSplashMenuItem}">
            <actions:ShowSplashAction/>
          </ai:DropDownItem>
          <ai:DropDownItem name="ShowShortcuts" caption="{messages.showShortcuts}">
            <actions:ShowShortcutsAction/>
          </ai:DropDownItem>
        </ai:DropDownButton>

        <g:FlowPanel styleName="ode-TopPanelLinks flex items-center gap-2" ui:field="links">
          <ai:DropDownButton styleName="ode-TopPanelButton px-3 py-1.5 rounded-full border border-slate-200 bg-white hover:bg-slate-50 text-[#4f46e5] text-xs font-medium transition cursor-pointer" rightAlign="true"
                             ui:field="languageDropDown" icon="language"/>
          <ai:DropDownButton styleName="ode-TopPanelButton p-2 rounded-full border border-indigo-100 bg-indigo-50/60 hover:bg-indigo-100/80 text-[#4f46e5] transition cursor-pointer" rightAlign="true"
                             ui:field="accountButton" icon="account_circle">
            <ai:DropDownItem name="Signout" caption="{messages.signOutLink}">
              <actions:SignOutAction/>
            </ai:DropDownItem>
            <ai:DropDownItem name="Signout" ui:field="deleteAccountItem"
                             caption="{messages.deleteAccountLink}">
              <actions:DeleteAccountAction/>
            </ai:DropDownItem>
          </ai:DropDownButton>
        </g:FlowPanel>
      </g:FlowPanel>
    </g:FlowPanel>
  </g:FlowPanel>
</ui:UiBinder>
